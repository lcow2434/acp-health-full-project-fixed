# Copy to .env and fill in real values. Never commit .env.

PORT=4000
ALLOWED_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://user:password@localhost:5432/acp_health
PGSSL=false

# Long random string — e.g. `openssl rand -hex 32`
JWT_SECRET=change_me_to_a_long_random_secret

# Server-side only. Never exposed to the client / never put in frontend code.
GOOGLE_PLACES_API_KEY=your_key_here

# Payments — Stripe Connect (marketplace split payments)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
PLATFORM_FEE_PERCENT=8

# Video — Zoom Server-to-Server OAuth app
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Email — SendGrid (or swap for any transactional email provider)
SENDGRID_API_KEY=your_sendgrid_key
NOTIFICATIONS_FROM_EMAIL=appointments@yourdomain.com
